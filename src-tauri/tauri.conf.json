{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prosa",
  "version": "0.1.2",
  "identifier": "io.github.wad-man.prosa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Prosa",
        "width": 1100,
        "height": 780,
        "minWidth": 520,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "Russian"],
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "name": "Prosa Markdown Document",
        "ext": ["md", "markdown", "mdown", "mkd"],
        "description": "Markdown document",
        "role": "Editor"
      }
    ]
  }
}
