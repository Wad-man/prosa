{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProsaMD",
  "version": "0.1.8-rc.1",
  "identifier": "io.github.wad-man.prosa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ProsaMD",
        "width": 1100,
        "height": 780,
        "minWidth": 520,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "Russian"],
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "name": "ProsaMD Markdown Document",
        "ext": ["md", "markdown", "mdown", "mkd"],
        "description": "Markdown document",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGOTdEOEEzNkFBREJGQ0UKUldUT3Y2MXFvOWlYLzdjTUN2N2RaakRSK24xaHU5UlJwQzRyVU5Ib3QvVkZPQVRJSDM5Qld5a1IK",
      "endpoints": [
        "https://github.com/Wad-man/prosa/releases/latest/download/latest.json"
      ]
    }
  }
}
