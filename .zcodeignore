# Node
node_modules/
dist/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/

# Updater signing key (public key is committed, private must never be)
src-tauri/keys/*.key

# Local machine config (proxy workaround etc.)
.npmrc

# Binary installers not part of the source
*.dmg
*.exe
*.deb
*.msi
*.AppImage
*.snap

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
*.log

